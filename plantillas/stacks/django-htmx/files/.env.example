# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
APP_PORT=8000
# Django: clave de firma (sesiones, CSRF). Obligatoria en prod.
DJANGO_SECRET_KEY=__GENERATE__
# Hosts aceptados, separados por coma (CAMBIAR en prod: agrega tu dominio). /health responde aunque el host no esté.
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https de confianza para formularios detrás de un proxy TLS (ej. https://midominio.com), separados por coma
CSRF_TRUSTED_ORIGINS=
# Ruta del admin (cámbiala en prod para no exponer /admin/)
ADMIN_URL=admin/
# Duración de la sesión de login en segundos (ver djhtmx-patterns/references/auth.md)
SESSION_COOKIE_AGE=1209600
