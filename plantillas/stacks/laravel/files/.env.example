# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
# APP_ENV y APP_DEBUG los fija compose según el entorno (dev o prod).
APP_NAME=App
APP_KEY=base64:__GENERATE_B64__
# URL pública (CAMBIAR en prod, con https)
APP_URL=http://localhost:8000
APP_PORT=8000
LOG_CHANNEL=stderr
# Sin BD ni Redis funcionan file/sync; cámbialos tras infra-setup (database o redis)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Sanctum: dominios del front que usan cookie de sesión (CAMBIAR en prod)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
