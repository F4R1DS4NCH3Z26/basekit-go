# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) y reemplaza __GENERATE__ por secretos aleatorios.
APP_PORT=8000
# CORS: orígenes permitidos separados por coma (CAMBIAR en prod)
CORS_ORIGINS=http://localhost:3000
# JWT
JWT_SECRET=__GENERATE__
JWT_ISSUER=app
JWT_AUDIENCE=app-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
