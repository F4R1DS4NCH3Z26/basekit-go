# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod); si ya existe, solo agrega las variables nuevas.
# Puerto publicado en el host (Vite en dev, nginx en prod)
APP_PORT=5173
# URL base de la API que consume la SPA. Es PÚBLICA: Vite la incrusta en el JS (nunca pongas secretos en VITE_*).
# CAMBIAR en prod por la URL real, con https. En prod se aplica al construir la imagen (make prod-up).
VITE_API_URL=http://localhost:8000
