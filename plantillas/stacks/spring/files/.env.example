# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
APP_PORT=8080
# JWT (Spring Security resource server con emisor propio)
JWT_SECRET=__GENERATE__
JWT_ISSUER=app
JWT_AUDIENCE=app-clients
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D
# CORS: orígenes permitidos separados por coma (CAMBIAR en prod)
CORS_ORIGINS=http://localhost:3000
