# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
# APP_ENV y APP_DEBUG los fija compose según el entorno (dev o prod). DB_DRIVER, DB_* y DATABASE_URL, y REDIS_*, los inyectan los overlays de infra-setup.
APP_PORT=8000
# CORS: orígenes con acceso, separados por coma (ej. http://localhost:5173). Vacía: ningún origen externo. En prod, la URL real con https.
CORS_ORIGINS=
