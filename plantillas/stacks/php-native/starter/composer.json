{
    "name": "app/api",
    "description": "API REST en PHP nativo: front controller, router propio y PDO (generada por basekit)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.27",
        "phpstan/phpstan": "2.3.2",
        "phpunit/phpunit": "13.3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
