# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
# APP_ENV y APP_DEBUG los fija compose según el entorno (dev o prod). DATABASE_URL y REDIS_URL los inyectan los overlays de infra-setup.
APP_SECRET=__GENERATE__
APP_PORT=8000
# CORS: orígenes con acceso, separados por coma (ej. http://localhost:5173). Vacía: ningún origen externo. En prod, la URL real con https.
CORS_ORIGINS=
# URL base para generar enlaces absolutos fuera de una petición (CAMBIAR en prod, con https)
DEFAULT_URI=http://localhost:8000
