# Generado por basekit. `make env` crea .env (o .env.prod con ENV=prod) con secretos aleatorios; si ya existe, solo agrega las variables nuevas.
APP_PORT=8000
# Django: clave de firma (sesiones, CSRF). Obligatoria en prod.
DJANGO_SECRET_KEY=__GENERATE__
# Hosts aceptados, separados por coma (CAMBIAR en prod: agrega tu dominio). /health responde aunque el host no esté.
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https de confianza para formularios (admin detrás de un proxy TLS), separados por coma
CSRF_TRUSTED_ORIGINS=
# Ruta del admin (cámbiala en prod para no exponer /admin/)
ADMIN_URL=admin/
# CORS: orígenes permitidos separados por coma (CAMBIAR en prod)
CORS_ORIGINS=http://localhost:3000
# JWT (SimpleJWT, ver django-patterns/references/auth.md)
JWT_SECRET=__GENERATE__
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
